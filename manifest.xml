<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
    xsi:type="MailApp">

    <Id>a8d94464-d472-48d7-83d3-602260fece6d</Id>

    <Version>1.0.0.0</Version>

    <ProviderName>Narender K</ProviderName>

    <DefaultLocale>en-US</DefaultLocale>

    <DisplayName DefaultValue="AIReplyAssistant"/>

    <Description DefaultValue="AI-powered Outlook assistant."/>

    <IconUrl DefaultValue="https://ai-reply-assistant-tau.vercel.app/assets/icon-64.png"/>

    <HighResolutionIconUrl DefaultValue="https://ai-reply-assistant-tau.vercel.app/assets/icon-128.png"/>

    <SupportUrl DefaultValue="https://nihilent.com"/>

    <AppDomains>
        <AppDomain>https://ai-reply-assistant-tau.vercel.app</AppDomain>
    </AppDomains>

    <Hosts>
        <Host Name="Mailbox"/>
    </Hosts>

    <Requirements>

        <Sets>
            <Set Name="Mailbox" MinVersion="1.5"/>
        </Sets>

    </Requirements>

    <FormSettings>

        <Form xsi:type="ItemRead">

            <DesktopSettings>

                <SourceLocation DefaultValue="https://ai-reply-assistant-tau.vercel.app/src/taskpane/taskpane.html"/>

                <RequestedHeight>250</RequestedHeight>

            </DesktopSettings>

        </Form>

    </FormSettings>

    <Permissions>ReadWriteItem</Permissions>

    <Rule xsi:type="RuleCollection" Mode="Or">

        <Rule xsi:type="ItemIs"
            ItemType="Message"
            FormType="Read"/>

    </Rule>

    <DisableEntityHighlighting>false</DisableEntityHighlighting>

    ```xml
<VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>

        <bt:Sets DefaultMinVersion="1.5">

            <bt:Set Name="Mailbox"/>

        </bt:Sets>

    </Requirements>

    <Hosts>

        <Host xsi:type="MailHost">

            <DesktopFormFactor>

                <FunctionFile resid="Commands.Url"/>

                <ExtensionPoint
                    xsi:type="MessageReadCommandSurface">

                    <OfficeTab id="TabDefault">

                        <Group id="AIReplyGroup">

                            <Label resid="GroupLabel"/>

                            <!-- AI Reply -->

                            <Control
                                xsi:type="Button"
                                id="AIReplyButton">

                                <Label
                                    resid="AIReply.Label"/>

                                <Supertip>

                                    <Title
                                        resid="AIReply.Label"/>

                                    <Description
                                        resid="AIReply.Tooltip"/>

                                </Supertip>

                                <Icon>

                                    <bt:Image
                                        size="16"
                                        resid="Icon.16x16"/>

                                    <bt:Image
                                        size="32"
                                        resid="Icon.32x32"/>

                                    <bt:Image
                                        size="80"
                                        resid="Icon.80x80"/>

                                </Icon>

                                <Action
                                    xsi:type="ExecuteFunction">

                                    <FunctionName>
                                        generateAIReply
                                    </FunctionName>

                                </Action>

                            </Control>

                            <!-- Auto Pilot -->

                            <Control
                                xsi:type="Button"
                                id="AutoPilotButton">

                                <Label
                                    resid="AutoPilot.Label"/>

                                <Supertip>

                                    <Title
                                        resid="AutoPilot.Label"/>

                                    <Description
                                        resid="AutoPilot.Tooltip"/>

                                </Supertip>

                                <Icon>

                                    <bt:Image
                                        size="16"
                                        resid="Icon.16x16"/>

                                    <bt:Image
                                        size="32"
                                        resid="Icon.32x32"/>

                                    <bt:Image
                                        size="80"
                                        resid="Icon.80x80"/>

                                </Icon>

                                <Action
                                    xsi:type="ShowTaskpane">

                                    <SourceLocation
                                        resid="Taskpane.Url"/>

                                    <SupportsPinning>
                                        true
                                    </SupportsPinning>

                                </Action>

                            </Control>

                        </Group>

                    </OfficeTab>

                </ExtensionPoint>

            </DesktopFormFactor>

        </Host>

    </Hosts>

    <Resources>

        <bt:Images>

            <bt:Image
                id="Icon.16x16"
                DefaultValue="https://ai-reply-assistant-tau.vercel.app/assets/icon-16.png"/>

            <bt:Image
                id="Icon.32x32"
                DefaultValue="https://ai-reply-assistant-tau.vercel.app/assets/icon-32.png"/>

            <bt:Image
                id="Icon.80x80"
                DefaultValue="https://ai-reply-assistant-tau.vercel.app/assets/icon-80.png"/>

        </bt:Images>

        <bt:Urls>

            <bt:Url
                id="Commands.Url"
                DefaultValue="https://ai-reply-assistant-tau.vercel.app/src/commands/commands.html"/>

            <bt:Url
                id="Taskpane.Url"
                DefaultValue="https://ai-reply-assistant-tau.vercel.app/src/taskpane/taskpane.html"/>

        </bt:Urls>

        <bt:ShortStrings>

            <bt:String
                id="GroupLabel"
                DefaultValue="AI Assistant"/>

            <bt:String
                id="AIReply.Label"
                DefaultValue="AI Reply"/>

            <bt:String
                id="AutoPilot.Label"
                DefaultValue="Auto Pilot"/>

        </bt:ShortStrings>

        <bt:LongStrings>

            <bt:String
                id="AIReply.Tooltip"
                DefaultValue="Generate AI-powered reply instantly."/>

            <bt:String
                id="AutoPilot.Tooltip"
                DefaultValue="Configure AI automation and insights."/>

        </bt:LongStrings>

    </Resources>

</VersionOverrides>



</OfficeApp>